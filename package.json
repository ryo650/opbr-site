{
  "name": "opbr-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "medals:import": "node scripts/medal-importer/import.mjs",
    "medals:regression": "node scripts/medal-importer/import.mjs --dry-run --regression",
    "medals:test": "node --test scripts/medal-importer/*.test.mjs",
    "medals:validate": "node scripts/medal-importer/validate-output.mjs",
    "medals:validate-importer-batch": "node scripts/medal-importer/validate-importer-batch.mjs",
    "medals:validate-tag-effects": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/medal-tag-effects/validate-tag-effects.mjs",
    "medals:approve-status": "node scripts/medal-importer/approve-status.mjs",
    "medals:generate-status-types": "node scripts/medal-importer/generate-status-types.mjs",
    "medals:approve-native-effect": "node scripts/medal-importer/approve-native-effect.mjs",
    "medals:generate-native-effect-types": "node scripts/medal-importer/generate-native-effect-types.mjs",
    "medals:generate-unique-trait-categories": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/medal-unique-traits/generate.mjs",
    "medals:generate-unique-trait-effects": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/medal-unique-traits/generate-effects.mjs",
    "medals:audit-unique-trait-effects": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/medal-unique-traits/audit-effects.mjs",
    "medals:test-unique-trait-categories": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/medal-unique-traits/*.test.mjs",
    "medals:generate-extra-traits": "node scripts/medal-extra-traits/generate.mjs",
    "medals:audit-selectable-extra-traits": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/medal-extra-traits/audit-selectable.mjs",
    "medals:test-effect-cap-usage": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/medal-extra-traits/effect-cap-usage.test.mjs",
    "medals:test-character-stats": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/medal-extra-traits/character-stats-preview.test.mjs",
    "medals:test-extra-traits": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/medal-extra-traits/*.test.mjs",
    "characters:validate-level-100-stats": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/character-level-100-stats/validate.mjs",
    "characters:test-level-100-stats": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/character-level-100-stats/*.test.mjs",
    "characters:import-level-100-stats-screenshot": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/character-level-100-stats/import-screenshot.mjs --dry-run",
    "characters:test-level-100-stats-importer": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/character-level-100-stats/screenshot-importer.test.mjs",
    "scouts:import": "node scripts/scout-importer/import.mjs",
    "scouts:test": "node --test scripts/scout-importer/*.test.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.10",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
