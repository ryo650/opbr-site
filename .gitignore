# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# public
public_backup/

# medal importer local inputs and reproducible intermediate files
/scripts/medal-importer/input/
/scripts/medal-importer/draft-medals.json
/scripts/medal-importer/.tmp/
# Local persistent audit evidence; never part of input/staging cleanup.
/scripts/medal-importer/audit/

/scripts/medal-tag-effects/input/

# Character Lv.100 screenshot importer local review artifact
/scripts/character-level-100-stats/draft-screenshot.json

# scout importer local inputs and staging files
/scripts/scout-importer/input/*
!/scripts/scout-importer/input/.gitkeep
/scripts/scout-importer/.tmp/

# Character Stats local OCR cache and atomic save staging
/scripts/character-stats-importer/.cache/
/src/data/characters/max-level-stats.json.lock
/src/data/characters/max-level-stats.json.*.tmp

# Character Stats source screenshots are local-only, never Git artifacts
/scripts/character-stats-importer/input/
/scripts/character-stats-importer/fixtures/images/
/scripts/character-stats-importer/qa/*.png
/scripts/character-stats-importer/qa/*.jpg
/scripts/character-stats-importer/qa/*.jpeg
# Local Base Stats pre-save snapshots (structured TypeScript data only)
src/data/characters/.character-stats-backups/
src/data/characters/level-100-base-stats.ts.lock
src/data/characters/level-100-base-stats.ts.*.tmp
